# Server
PORT=4980
PUBLIC_URL=http://127.0.0.1:4980
# DB_PATH=/var/data/musk2028.db       # on Render, point at the persistent disk
# TRUST_PROXY=1                        # set behind Render/Cloudflare so rate limits use the real client IP
IP_SALT=change-me-to-a-random-string
CONTACT_EMAIL=

# Admin CSV export: GET /admin/export.csv with header "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=

# Email confirmation (optional). Without these, emails are stored but stay UNVERIFIED and no mail is sent.
# SMTP_URL=smtps://USER:PASS@smtp.example.com:465
# FROM_EMAIL="Musk2028 <hello@yourdomain.com>"

# Verify with X (optional). Without these, the button shows "coming soon".
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=https://yourdomain.com/auth/x/callback
